{
  "name": "clawterm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf .clawterm-web && node --max-old-space-size=2048 ./node_modules/vite/bin/vite.js build && rm -rf android/app/src/main/assets/web && cp -r .clawterm-web android/app/src/main/assets/web",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p web/tsconfig.json",
    "lint": "cd web && npx eslint src/",
    "lint:css": "cd web && npx stylelint \"src/**/*.{css,vue}\" \"css/**/*.css\""
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.35",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.0",
    "xterm-theme": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.0.2",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.2.12"
  }
}
